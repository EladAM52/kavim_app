# ══════════════════════════════════════════════════════════════════════════
#  Kavim — environment configuration
#  Copy to .env and fill in. .env is gitignored and must never be committed.
#  Every variable here is declared in backend/app/core/config.py.
# ══════════════════════════════════════════════════════════════════════════

# ── application ───────────────────────────────────────────────────────────
APP_NAME=Kavim
APP_ENV=development                     # development | staging | production
APP_DEBUG=true                          # must be false in production
APP_BASE_URL=http://localhost:5173      # builds invitation / reset links
API_PREFIX=/api/v1
# Path prefix the browser sees when a reverse proxy serves the app under a
# subpath (e.g. /kavim). Empty at a host root, which is the localhost case.
# nginx strips it, so routing is unaffected — it exists for the refresh
# cookie's path, which the browser matches against the address bar.
APP_PUBLIC_PATH=
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                          # false = human-readable dev logs

# ── security ──────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this invalidates every active session.
SECRET_KEY=CHANGE_ME_generate_a_long_random_value
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LIMIT_PER_15MIN=3
INVITATION_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=15

# ── database ──────────────────────────────────────────────────────────────
POSTGRES_USER=kavim
POSTGRES_PASSWORD=kavim_dev_password
POSTGRES_DB=kavim
POSTGRES_PORT=5432
# Host runs (uvicorn on Windows) use localhost; inside Docker the host is "db".
# docker-compose.yml overrides this for the container.
DATABASE_URL=postgresql+asyncpg://kavim:kavim_dev_password@localhost:5432/kavim
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# ── redis ─────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── localization ──────────────────────────────────────────────────────────
DEFAULT_LOCALE=he                       # he | en
SUPPORTED_LOCALES=he,en
DEFAULT_TIMEZONE=Asia/Jerusalem

# ── CORS (development only — production is single-origin) ─────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── email — Gmail SMTP (ADR-007) ──────────────────────────────────────────
# EMAIL_DRY_RUN=true renders the message and logs it. Nothing is sent and no
# connection is opened, so development needs no credentials at all.
#
# To send for real:
#   1. Enable 2-step verification on kavimsupport@gmail.com
#   2. https://myaccount.google.com/apppasswords -> generate one for "Kavim"
#   3. Paste the 16-character value into SMTP_PASSWORD below (no spaces)
#   4. EMAIL_ENABLED=true and EMAIL_DRY_RUN=false
#
# The App Password is NOT the account password. Never commit it — this file is
# the template; real values live in .env, which is gitignored.
EMAIL_ENABLED=false
EMAIL_DRY_RUN=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=kavimsupport@gmail.com
SMTP_PASSWORD=
SMTP_STARTTLS=true                      # 587 + STARTTLS
SMTP_USE_TLS=false                      # set true (and PORT=465) for implicit TLS
SMTP_TIMEOUT_SECONDS=30
# On free Gmail this MUST equal SMTP_USERNAME — Gmail silently rewrites any
# other sender rather than rejecting it. Blank falls back to SMTP_USERNAME.
EMAIL_FROM_ADDRESS=kavimsupport@gmail.com
EMAIL_FROM_NAME=Kavim
EMAIL_REPLY_TO=
# Free Gmail ~500 recipients/day, Workspace ~2000. Exceeding it suspends
# sending for 24 hours, taking OTP and invitations down with it (FR-714).
EMAIL_DAILY_QUOTA=500

# ── SMS ───────────────────────────────────────────────────────────────────
# Deferred (SPEC §6.14.1). No provider is integrated, so there is nothing to
# configure. The sms channel stays in the schema; adding a provider later needs
# no migration.

# ── file storage ──────────────────────────────────────────────────────────
STORAGE_BACKEND=local                   # local | s3
STORAGE_LOCAL_PATH=./.storage
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PRESIGN_TTL_SECONDS=900
UPLOAD_MAX_BYTES=26214400               # 25 MB

# ── observability ─────────────────────────────────────────────────────────
SENTRY_DSN=

# ── frontend (Vite — only VITE_* is exposed to the browser) ───────────────
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=ws://localhost:8000/ws
VITE_DEFAULT_LOCALE=he
