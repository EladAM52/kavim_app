# ══════════════════════════════════════════════════════════════════════════
#  Kavim — environment configuration
#  Copy to .env and fill in. .env is gitignored and must never be committed.
#  Every variable here is declared in backend/app/core/config.py.
# ══════════════════════════════════════════════════════════════════════════

# ── application ───────────────────────────────────────────────────────────
APP_NAME=Kavim
APP_ENV=development                     # development | staging | production
APP_DEBUG=true                          # must be false in production
APP_BASE_URL=http://localhost:5173      # builds invitation / reset links
API_PREFIX=/api/v1
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                          # false = human-readable dev logs

# ── security ──────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this invalidates every active session.
SECRET_KEY=CHANGE_ME_generate_a_long_random_value
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LIMIT_PER_15MIN=3
INVITATION_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=15

# ── database ──────────────────────────────────────────────────────────────
POSTGRES_USER=kavim
POSTGRES_PASSWORD=kavim_dev_password
POSTGRES_DB=kavim
POSTGRES_PORT=5432
# Host runs (uvicorn on Windows) use localhost; inside Docker the host is "db".
# docker-compose.yml overrides this for the container.
DATABASE_URL=postgresql+asyncpg://kavim:kavim_dev_password@localhost:5432/kavim
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# ── redis ─────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── localization ──────────────────────────────────────────────────────────
DEFAULT_LOCALE=he                       # he | en
SUPPORTED_LOCALES=he,en
DEFAULT_TIMEZONE=Asia/Jerusalem

# ── CORS (development only — production is single-origin) ─────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── SendGrid (email) ──────────────────────────────────────────────────────
# SENDGRID_SANDBOX=true means nothing actually leaves the machine.
# Leave sandbox on until domain authentication (SPF + DKIM) is verified.
SENDGRID_ENABLED=false
SENDGRID_SANDBOX=true
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@example.com
SENDGRID_FROM_NAME=Kavim
SENDGRID_WEBHOOK_KEY=
# One dynamic template id per event (d-xxxxxxxx)
SENDGRID_TEMPLATE_INVITATION=
SENDGRID_TEMPLATE_OTP=
SENDGRID_TEMPLATE_PASSWORD_RESET=
SENDGRID_TEMPLATE_TASK_ASSIGNED=
SENDGRID_TEMPLATE_MENTION=
SENDGRID_TEMPLATE_OVERDUE=
SENDGRID_TEMPLATE_DIGEST=

# ── Twilio (SMS) ──────────────────────────────────────────────────────────
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_STATUS_CALLBACK_URL=

# ── file storage ──────────────────────────────────────────────────────────
STORAGE_BACKEND=local                   # local | s3
STORAGE_LOCAL_PATH=./.storage
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PRESIGN_TTL_SECONDS=900
UPLOAD_MAX_BYTES=26214400               # 25 MB

# ── observability ─────────────────────────────────────────────────────────
SENTRY_DSN=

# ── frontend (Vite — only VITE_* is exposed to the browser) ───────────────
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=ws://localhost:8000/ws
VITE_DEFAULT_LOCALE=he
