# ══════════════════════════════════════════════════════════════════════════
#  Kavim — production environment
#
#  Copy this to the REPO ROOT on the server as `.env` and fill in every value
#  marked CHANGE_ME. Nothing here is a secret; the file you create from it is.
#
#      cp infra/env.production.example .env
#      chmod 600 .env
#
#  `.env` is gitignored. Never commit the filled-in copy, and never paste its
#  contents into a chat, an issue, or a terminal that is being recorded — a
#  secret that has been pasted anywhere must be treated as leaked and rotated.
#
#  Your local development .env is untouched by this: it stays as it is, and the
#  localhost stack keeps working exactly as before.
# ══════════════════════════════════════════════════════════════════════════

# ── application ───────────────────────────────────────────────────────────
APP_NAME=Kavim
APP_ENV=production
APP_DEBUG=false

# The public URL of the app, including the subpath. This is what emailed
# invitation and password-reset links are built from (`invitations.py`), so a
# wrong value here produces links that 404 for every new user.
APP_BASE_URL=https://srv1515969.hstgr.cloud/kavim

# The path prefix the browser sees. No trailing slash. Leave EMPTY when the app
# is served at a host root.
#
# nginx strips this before proxying, so the application still routes at "/".
# The one thing it is needed for is the refresh cookie's path: the browser
# matches that against the address bar, so without it login succeeds and the
# next page load silently signs the user out.
APP_PUBLIC_PATH=/kavim

API_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_JSON=true

# ── security ──────────────────────────────────────────────────────────────
# CHANGE_ME — generate on the server, never reuse the development key:
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
# Rotating this invalidates every access token and every session at once.
SECRET_KEY=CHANGE_ME_generate_a_long_random_value

JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LIMIT_PER_15MIN=3
INVITATION_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=15

# ── database ──────────────────────────────────────────────────────────────
# CHANGE_ME — a long random password. Postgres is not published to the host in
# the production compose file, but this is still the credential that protects
# every quality record in the system.
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_USER=kavim
POSTGRES_PASSWORD=CHANGE_ME_long_random_password
POSTGRES_DB=kavim

# Used by host-side tooling (alembic, psql) when run outside the compose
# network. The containers override it with the `db` service name, so both work
# from one file. Keep the password identical to POSTGRES_PASSWORD above.
DATABASE_URL=postgresql+asyncpg://kavim:CHANGE_ME_long_random_password@localhost:5432/kavim
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# ── redis / celery ────────────────────────────────────────────────────────
# Overridden in-network by compose; these values are for host-side tooling.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── localization ──────────────────────────────────────────────────────────
DEFAULT_LOCALE=he
SUPPORTED_LOCALES=he,en
DEFAULT_TIMEZONE=Asia/Jerusalem

# ── CORS ──────────────────────────────────────────────────────────────────
# Empty, and it must stay empty. The SPA is served by the same FastAPI process
# on the same origin, so there is no cross-origin request to allow — and an
# origin listed here is an origin permitted to make credentialed calls.
CORS_ORIGINS=

# ── email (ADR-007) ───────────────────────────────────────────────────────
# Production refuses to start with EMAIL_DRY_RUN=true: invitations and OTP
# codes cannot be delivered, so nobody could ever register.
EMAIL_ENABLED=true
EMAIL_DRY_RUN=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=kavimsupport@gmail.com
# CHANGE_ME — the Google App Password (16 characters, no spaces), not the
# account password. On Gmail, EMAIL_FROM_ADDRESS must equal SMTP_USERNAME:
# Gmail silently rewrites any other sender rather than rejecting it, so the
# settings guard makes a mismatch a startup error instead.
SMTP_PASSWORD=CHANGE_ME_gmail_app_password
SMTP_STARTTLS=true
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=30
EMAIL_FROM_ADDRESS=kavimsupport@gmail.com
EMAIL_FROM_NAME=Kavim
EMAIL_REPLY_TO=
# Free Gmail is ~500 recipients/day, hard. Exceeding it suspends sending for 24
# hours and takes OTP delivery down with it, so the outbox meters against this
# (FR-714) rather than finding out the hard way.
EMAIL_DAILY_QUOTA=500

# ── storage (MinIO, S3-compatible) ────────────────────────────────────────
# STORAGE_BACKEND=local is refused in production: a container filesystem is not
# durable, so a rebuild would lose every attachment. MinIO runs in the compose
# stack and speaks the S3 API, so moving to real S3 later is a credentials
# change rather than a data migration.
STORAGE_BACKEND=s3
STORAGE_BUCKET=kavim-attachments
# The container reaches MinIO on the compose network; compose sets this for the
# app. Left here for host-side tooling.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
# CHANGE_ME — these are also MinIO's root credentials (see docker-compose.prod.yml).
#     python -c "import secrets; print(secrets.token_urlsafe(24))"
STORAGE_ACCESS_KEY=CHANGE_ME_minio_access_key
STORAGE_SECRET_KEY=CHANGE_ME_minio_secret_key
STORAGE_PRESIGN_TTL_SECONDS=900
UPLOAD_MAX_BYTES=26214400

# ── observability ─────────────────────────────────────────────────────────
# Optional. Leave empty to disable Sentry.
SENTRY_DSN=

# ── runtime sizing (read by docker-compose.prod.yml, not by the app) ──────
# The backend binds 127.0.0.1 only; nginx is the sole route in.
BACKEND_PORT=8000
# Two workers suits a 2 vCPU box. Rule of thumb: (2 × cores) + 1, capped by RAM
# — each worker holds its own database pool.
UVICORN_WORKERS=2
