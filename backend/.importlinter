; Module boundary rules (SPEC §5.1, CLAUDE.md rule 3).
; Run: uv run lint-imports
;
; These make the modular monolith real. Without mechanical enforcement the
; boundaries decay within weeks; with them, any module stays extractable into
; its own service later without rewriting call sites.
;
; The "no cross-module router imports" contract at the bottom was deferred until
; Phase 2, because import-linter errors on modules that do not exist yet. The
; routers now exist, so it is enforced.

[importlinter]
root_package = app
include_external_packages = True

; ── layering ──────────────────────────────────────────────────────────────
; Each layer may import the ones below it, never the ones above.
[importlinter:contract:layers]
name = Layered architecture
type = layers
layers =
    app.workers
    app.modules
    app.schemas
    app.models
    app.integrations
    app.core

; ── core is the substrate and depends on nothing above it ─────────────────
[importlinter:contract:core-independence]
name = core must not import modules, schemas, integrations, or workers
type = forbidden
source_modules =
    app.core
forbidden_modules =
    app.modules
    app.schemas
    app.integrations
    app.workers

; ── integrations wrap external SDKs and stay leaf-level ───────────────────
[importlinter:contract:integrations-independence]
name = integrations must not import application modules
type = forbidden
source_modules =
    app.integrations
forbidden_modules =
    app.modules
    app.models
    app.schemas
    app.workers

; ── external provider clients appear ONLY in integrations ─────────────────
; Keeps the app portable (SPEC NFR-20) and gives tests one place to stub.
; smtplib is listed alongside aiosmtplib on purpose: being in the standard
; library makes it *easier* to reach for by accident, not more acceptable.
; allow_indirect_imports, because the rule is about *direct* imports. Anything
; that actually sends mail reaches aiosmtplib transitively through the
; integrations seam — that is the seam working, not a violation. Counting the
; indirect chain would make the contract unsatisfiable for the sweeper and force
; it to be weakened or deleted, which is worse than scoping it correctly.
[importlinter:contract:sdk-containment]
name = provider clients only inside app.integrations
type = forbidden
allow_indirect_imports = True
source_modules =
    app.core
    app.models
    app.schemas
    app.modules
    app.workers
forbidden_modules =
    aiosmtplib
    smtplib
    boto3

; ── one module never reaches into another's HTTP layer ────────────────────
; A router is a module's edge, not its API. Calling another module's router means
; coupling to its request/response shapes, its dependencies, and its status codes
; — and it is how a modular monolith quietly becomes unextractable.
; Cross-module calls go through `service.py`. `main.py` is the only importer of
; routers, and it is not a module.
[importlinter:contract:no-cross-module-routers]
name = modules must not import each other's routers
type = forbidden
source_modules =
    app.modules.auth
    app.modules.audit
    app.modules.notifications
forbidden_modules =
    app.modules.auth.router
    app.modules.audit.router
    app.modules.notifications.router
